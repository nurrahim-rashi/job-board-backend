DATABASE_URL=postgresql://user:password@localhost:5432/job-board
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
EMAIL_FROM=Polaris <noreply@example.com>
RESEND_API_KEY=re_replace_me
# Must carry a REAL contact address. OSM's Nominatim returns 403 for a
# placeholder contact, which disables the geocoding fallbacks.
GEOCODING_USER_AGENT=PolarisJobBoard/1.0 (your-contact-email@example.com)
PHOTON_API_URL=https://photon.komoot.io
INTERVIEW_TIMEZONE=Asia/Jakarta
SUBSCRIPTION_TIMEZONE=Asia/Jakarta
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
