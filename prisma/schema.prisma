generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator erd {
  provider     = "prisma-erd-generator"
  output       = "../docs/erd.svg"
  renderer     = "graphviz"
  disableEmoji = true
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  JOB_SEEKER
  COMPANY_ADMIN
  DEVELOPER
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum Gender {
  MALE
  FEMALE
}

enum ApplicationStatus {
  DRAFT
  PENDING
  TEST_ASSIGNED
  PROCESS
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum SubscriptionName {
  STANDARD
  PROFESSIONAL
}

enum UserSubscriptionStatus {
  PENDING_APPROVAL
  ACTIVE
  EXPIRED
}

enum AnswerOption {
  A
  B
  C
  D
}

enum JobCategory {
  TECHNOLOGY
  FINANCE
  MARKETING
  SALES
  DESIGN
  HUMAN_RESOURCES
  OPERATIONS
  EDUCATION
  HEALTHCARE
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id                         Int          @id @default(autoincrement())
  name                       String
  email                      String       @unique
  password                   String?
  authProvider               AuthProvider @default(EMAIL)
  role                       UserRole     @default(JOB_SEEKER)
  birthDate                  DateTime?
  gender                     Gender?
  lastEducation              String?
  address                    String?      @db.Text
  city                       String?
  province                   String?
  country                    String?
  avatar                     String?
  professionalRole           String       @default("")
  availability               String       @default("")
  profileIntro               String       @default("") @db.Text
  salaryExpectation          String       @default("")
  salaryExpectationCurrency  String       @default("IDR") @db.VarChar(3)
  profileStory               String       @default("") @db.Text
  lookingFor                 String[]     @default([])
  skills                     String[]     @default([])
  profileLinks               Json?
  experiences                Json?
  selectedWork               Json?
  isPublicProfile            Boolean      @default(true)
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?
  passwordResetExpiresAt     DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  company           Company?
  jobApplications   JobApplication[]
  savedJobs         SavedJob[]
  subscriptions     UserSubscription[]
  companyReviews    CompanyReview[]
  assessmentResults SkillAssessmentResult[]
  testResults       ApplicantTestResult[]

  @@map("users")
}

model Company {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  companyName    String
  phone          String
  profileContent String   @db.Text
  tagline        String   @default("")
  size           String   @default("")
  founded        Int?
  website        String   @default("")
  products       Json?
  values         String[] @default([])
  perks          String[] @default([])
  logo           String?
  banner         String?
  city           String
  province       String?
  country        String   @default("Indonesia")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User            @relation(fields: [userId], references: [id])
  jobPostings JobPosting[]
  reviews     CompanyReview[]

  @@map("companies")
}

model JobPosting {
  id                  Int         @id @default(autoincrement())
  companyId           Int
  title               String
  description         String      @db.Text
  banner              String?
  category            JobCategory
  cityLocation        String
  provinceLocation    String?
  countryLocation     String       @default("Indonesia")
  latitude            String?
  longitude           String?
  salaryMin           Int?
  salaryMax           Int?
  salaryCurrency      String      @default("IDR") @db.VarChar(3)
  hasPreSelectionTest Boolean     @default(false)
  testDurationMinutes Int?
  tags                Json?
  slug                String      @unique
  deadline            DateTime
  isPublished         Boolean     @default(false)
  deletedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  company           Company               @relation(fields: [companyId], references: [id])
  applications      JobApplication[]
  savedBy           SavedJob[]
  preSelectionTests PreSelectionTest[]
  testResults       ApplicantTestResult[]

  @@index([companyId, deletedAt])
  @@index([deletedAt, isPublished, deadline])
  @@map("job_postings")
}

model JobApplication {
  id              Int               @id @default(autoincrement())
  jobId           Int
  userId          Int
  cvFile          String
  expectedSalary  Int?
  expectedSalaryCurrency String @default("IDR") @db.VarChar(3)
  expectedSalaryRequestedAt DateTime?
  lastEducationSnapshot String?
  status          ApplicationStatus @default(PENDING)
  rejectionReason String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  job        JobPosting           @relation(fields: [jobId], references: [id])
  user       User                 @relation(fields: [userId], references: [id])
  testResult ApplicantTestResult?
  interview  Interview?

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId, createdAt])
  @@index([jobId, status])
  @@map("job_applications")
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  jobId     Int
  userId    Int
  createdAt DateTime @default(now())

  job  JobPosting @relation(fields: [jobId], references: [id])
  user User       @relation(fields: [userId], references: [id])

  @@unique([jobId, userId])
  @@index([userId, createdAt])
  @@map("saved_jobs")
}

model PreSelectionTest {
  id            Int          @id @default(autoincrement())
  jobId         Int
  question      String       @db.Text
  options       Json
  correctAnswer AnswerOption
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  job     JobPosting            @relation(fields: [jobId], references: [id])
  answers ApplicantTestAnswer[]

  @@index([jobId])
  @@map("pre_selection_tests")
}

model ApplicantTestResult {
  id               Int       @id @default(autoincrement())
  jobId            Int
  userId           Int
  jobApplicationId Int?      @unique
  score            Int?
  startedAt        DateTime  @default(now())
  submittedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job            JobPosting            @relation(fields: [jobId], references: [id])
  user           User                  @relation(fields: [userId], references: [id])
  jobApplication JobApplication?       @relation(fields: [jobApplicationId], references: [id])
  answers        ApplicantTestAnswer[]

  @@unique([jobId, userId])
  @@index([userId])
  @@map("applicant_test_results")
}

model ApplicantTestAnswer {
  id             Int          @id @default(autoincrement())
  testResultId   Int
  questionId     Int
  selectedAnswer AnswerOption
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  testResult ApplicantTestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)
  question   PreSelectionTest    @relation(fields: [questionId], references: [id])

  @@unique([testResultId, questionId])
  @@index([questionId])
  @@map("applicant_test_answers")
}

model Interview {
  id               Int             @id @default(autoincrement())
  jobApplicationId Int             @unique
  interviewDate    DateTime
  locationOrLink   String
  notes            String?         @db.Text
  status           InterviewStatus @default(SCHEDULED)
  reminderSentAt   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id])

  @@index([interviewDate, status, reminderSentAt])
  @@map("interviews")
}

model Subscription {
  id             Int              @id @default(autoincrement())
  name           SubscriptionName @unique
  price          Int
  durationDays   Int              @default(30)
  featuresAccess Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userSubscriptions UserSubscription[]

  @@map("subscriptions")
}

model UserSubscription {
  id             Int                    @id @default(autoincrement())
  userId         Int
  subscriptionId Int
  paymentProof   String?
  status         UserSubscriptionStatus @default(PENDING_APPROVAL)

  midtransOrderId     String? @unique
  midtransSnapToken   String?
  midtransRedirectUrl String?
  paymentStatus       String?

  startDate            DateTime?
  endDate              DateTime?
  expiryReminderSentAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([userId])
  @@index([subscriptionId])
  @@index([status, endDate])
  @@map("user_subscriptions")
}

model CompanyReview {
  id             Int      @id @default(autoincrement())
  companyId      Int
  userId         Int
  jobTitleHeld   String
  salaryEstimate Int?
  salaryCurrency String   @default("IDR") @db.VarChar(3)
  ratingCulture  Int
  ratingWorkLife Int
  ratingFacility Int
  ratingCareer   Int
  reviewText     String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("company_reviews")
}

model SkillAssessment {
  id              Int      @id @default(autoincrement())
  skillName       String   @unique
  title           String
  description     String?  @db.Text
  passingScore    Int      @default(75)
  durationMinutes Int      @default(30)
  questionCount   Int      @default(25)
  isPublished     Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  questions SkillAssessmentQuestion[]
  results   SkillAssessmentResult[]

  @@index([skillName])
  @@map("skill_assessments")
}

model SkillAssessmentQuestion {
  id            Int          @id @default(autoincrement())
  assessmentId  Int
  question      String       @db.Text
  options       Json
  correctAnswer AnswerOption
  questionOrder Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assessment SkillAssessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers    SkillAssessmentAnswer[]

  @@unique([assessmentId, questionOrder])
  @@index([assessmentId])
  @@map("skill_assessment_questions")
}

model SkillAssessmentResult {
  id              Int       @id @default(autoincrement())
  userId          Int
  assessmentId    Int
  score           Int
  isPassed        Boolean   @default(false)
  startedAt       DateTime
  completedAt     DateTime?
  certificateCode String?   @unique
  badgeName       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User                    @relation(fields: [userId], references: [id])
  assessment SkillAssessment         @relation(fields: [assessmentId], references: [id])
  answers    SkillAssessmentAnswer[]

  @@index([userId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
  @@map("skill_assessment_results")
}

model SkillAssessmentAnswer {
  id         Int          @id @default(autoincrement())
  resultId   Int
  questionId Int
  answer     AnswerOption
  isCorrect  Boolean
  createdAt  DateTime     @default(now())

  result   SkillAssessmentResult   @relation(fields: [resultId], references: [id], onDelete: Cascade)
  question SkillAssessmentQuestion @relation(fields: [questionId], references: [id])

  @@unique([resultId, questionId])
  @@index([resultId])
  @@index([questionId])
  @@map("skill_assessment_answers")
}
